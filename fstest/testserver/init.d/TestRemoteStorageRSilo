#!/usr/bin/env bash
# RSilo (draft -22) offline server in Docker for TestRemoteStorageRSilo:.
#
#   RSILO_IMAGE  image to run (default ghcr.io/jonocodes/rsilo:main, pulled
#                on every start); a local tag is only pulled if missing
#   RSILO_SRC    build the image from this RSilo checkout instead (e.g. a
#                branch under development)
#   S3_*         passed through, so RSilo stores its files in S3; the
#                endpoint must be reachable from inside the container

set -e

NAME=rclone-remotestorage-rsilo
PORT=18002

. $(dirname "$0")/docker.bash

start() {
    local image=${RSILO_IMAGE:-ghcr.io/jonocodes/rsilo:main} pull=always env=()
    [ -n "${RSILO_IMAGE:-}" ] && pull=missing
    if [ -n "${RSILO_SRC:-}" ]; then
        image=$NAME:dev pull=never
        docker build -q -t $image "$RSILO_SRC" >/dev/null
    fi
    for v in S3_ENDPOINT S3_BUCKET S3_REGION S3_ACCESS_KEY_ID S3_SECRET_ACCESS_KEY MAX_OBJECT_SIZE_BYTES; do
        [ -n "${!v:-}" ] && env+=(-e "$v")
    done
    docker run --rm -d --pull $pull --name $NAME -p 127.0.0.1:${PORT}:8787 "${env[@]}" $image >/dev/null
    for _ in $(seq 60); do curl -sf -o /dev/null http://127.0.0.1:${PORT}/health && break; sleep 0.5; done
    local token
    token=$(docker exec $NAME bun src/scripts/dev-token.ts alice '*:rw' </dev/null 2>/dev/null | tail -1)

    echo type=remotestorage
    echo storage_root=http://127.0.0.1:${PORT}/storage/alice
    echo token=$token
    echo _connect=127.0.0.1:${PORT}
}

. $(dirname "$0")/run.bash
