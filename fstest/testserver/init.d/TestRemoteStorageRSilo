#!/usr/bin/env bash
# RSilo (draft -22) in offline mode, SQLite plus a local directory, for
# TestRemoteStorageRSilo:. Needs git and bun.
#
#   RSILO_SRC   an RSilo checkout to run (e.g. a branch under development);
#               default: a clone of $RSILO_REPO at $RSILO_REF in ~/.cache
#   RSILO_REF   git ref for the default clone (default: main)

set -e

NAME=rclone-remotestorage-rsilo
PORT=18002
REPO=${RSILO_REPO:-https://github.com/jonocodes/RSilo}
REF=${RSILO_REF:-main}
DIR=${TMPDIR:-/tmp}/$NAME

source_dir() {
    if [ -n "${RSILO_SRC:-}" ]; then echo "$RSILO_SRC"; return; fi
    local dir=${XDG_CACHE_HOME:-$HOME/.cache}/rclone-remotestorage/rsilo
    [ -d "$dir/.git" ] || git clone -q "$REPO" "$dir" >&2
    git -C "$dir" fetch -q origin "$REF" >&2
    git -C "$dir" checkout -q --detach FETCH_HEAD >&2
    echo "$dir"
}

start() {
    local src
    src=$(source_dir)
    cd "$src"
    [ -d node_modules ] || bun install --frozen-lockfile >&2
    rm -rf "$DIR" && mkdir -p "$DIR"
    STORAGE_DIR=$DIR/storage DB_PATH=$DIR/db.sqlite PORT=$PORT \
        nohup bun src/server-offline.ts </dev/null >"$DIR/server.log" 2>&1 &
    echo $! >"$DIR/pid"
    for _ in $(seq 60); do curl -sf -o /dev/null http://localhost:$PORT/health && break; sleep 0.5; done
    curl -sf -o /dev/null http://localhost:$PORT/health || { cat "$DIR/server.log" >&2; return 1; }
    local token
    token=$(DB_PATH=$DIR/db.sqlite bun src/scripts/dev-token.ts alice '*:rw' </dev/null 2>/dev/null | tail -1)

    echo type=remotestorage
    echo storage_root=http://localhost:$PORT/storage/alice
    echo token=$token
    echo _connect=127.0.0.1:${PORT}
}

stop() {
    if status >/dev/null; then kill "$(cat "$DIR/pid")"; fi
    rm -rf "$DIR"
}

status() {
    if [ -f "$DIR/pid" ] && kill -0 "$(cat "$DIR/pid")" 2>/dev/null; then
        echo "$NAME running"
    else
        echo "$NAME not running"
        return 1
    fi
}

. $(dirname "$0")/run.bash
